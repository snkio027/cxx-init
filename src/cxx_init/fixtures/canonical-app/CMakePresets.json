{
  "version": 12,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 4,
    "patch": 4
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": true,
        "ENABLE_SANITIZERS": false,
        "CMAKE_EXPORT_COMPILE_COMMANDS": true,
        "CMAKE_TEST_BUILD_DEPENDS": true,
        "CMAKE_OSX_SYSROOT": "macosx"
      }
    },
    {
      "name": "dev",
      "displayName": "Development",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "san",
      "displayName": "Sanitizers",
      "inherits": "dev",
      "cacheVariables": {
        "ENABLE_SANITIZERS": true
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "san",
      "configurePreset": "san"
    },
    {
      "name": "release",
      "configurePreset": "release"
    }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error",
        "stopOnFailure": true,
        "jobs": ""
      }
    },
    {
      "name": "dev",
      "inherits": "base",
      "configurePreset": "dev"
    },
    {
      "name": "san",
      "inherits": "base",
      "configurePreset": "san"
    },
    {
      "name": "release",
      "inherits": "base",
      "configurePreset": "release"
    }
  ],
  "workflowPresets": [
    {
      "name": "dev",
      "displayName": "Development workflow",
      "steps": [
        {
          "type": "configure",
          "name": "dev"
        },
        {
          "type": "build",
          "name": "dev"
        },
        {
          "type": "test",
          "name": "dev"
        }
      ]
    },
    {
      "name": "san",
      "displayName": "Sanitizer workflow",
      "steps": [
        {
          "type": "configure",
          "name": "san"
        },
        {
          "type": "build",
          "name": "san"
        },
        {
          "type": "test",
          "name": "san"
        }
      ]
    },
    {
      "name": "release",
      "displayName": "Release workflow",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        },
        {
          "type": "test",
          "name": "release"
        }
      ]
    }
  ]
}
